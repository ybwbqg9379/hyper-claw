{
  "models": {
    "mode": "merge",
    "providers": {
      "local": {
        "baseUrl": "http://127.0.0.1:1234/v1",
        "apiKey": "local",
        "api": "openai-completions",
        "models": [
          {
            "id": "unsloth/Qwen3.5-4B-GGUF:Q4_K_M",
            "name": "Qwen3.5-4B Q4_K_M (Local)",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "maxTokens": 4096
          },
          {
            "id": "unsloth/Qwen3.5-4B-GGUF:Q4_K_M",
            "name": "Qwen3.5-4B Q4_K_M (Local)",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "maxTokens": 4096
          },
          {
            "id": "unsloth/Qwen3.5-9B-GGUF:Q4_K_M",
            "name": "Qwen3.5-9B Q4_K_M (Local)",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "maxTokens": 4096
          },
          {
            "id": "unsloth/DeepSeek-R1-0528-Qwen3-8B-GGUF:Q8_0",
            "name": "DeepSeek-R1-0528-Qwen3-8B Q8_0 (Local)",
            "reasoning": true,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "maxTokens": 4096
          }
        ]
      },
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "apiKey": "YOUR_DEEPSEEK_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "deepseek-chat",
            "name": "DeepSeek V3.2",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0.28,
              "output": 0.42,
              "cacheRead": 0.028,
              "cacheWrite": 0
            },
            "contextWindow": 128000,
            "maxTokens": 8192
          }
        ]
      },
      "moonshot": {
        "baseUrl": "https://api.moonshot.cn/v1",
        "apiKey": "YOUR_MOONSHOT_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "kimi-k2.5",
            "name": "Kimi K2.5",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0.28,
              "output": 0.42,
              "cacheRead": 0.028,
              "cacheWrite": 0
            },
            "contextWindow": 131072,
            "maxTokens": 8192
          }
        ]
      }
    }
  },

  "agents": {
    "defaults": {
      "model": "local/unsloth/Qwen3.5-4B-GGUF:Q4_K_M",
      "workspace": "~/.openclaw/workspace-personal",
      "compaction": {
        "mode": "safeguard",
        "reserveTokens": 200000,
        "keepRecentTokens": 20000
      },
      "heartbeat": {
        "every": "30m",
        "target": "last"
      },
      "maxConcurrent": 4,
      "subagents": {
        "model": "moonshot/kimi-k2.5",
        "maxConcurrent": 8
      }
    },
    "list": [
      {
        "id": "personal",
        "default": true,
        "workspace": "~/.openclaw/workspace-personal"
      },
      {
        "id": "hypercreator",
        "workspace": "~/.openclaw/workspace-hypercreator"
      },
      {
        "id": "raxonwood",
        "workspace": "~/.openclaw/workspace-raxonwood"
      },
      {
        "id": "strategist",
        "workspace": "~/.openclaw/workspace-strategist"
      }
    ]
  },

  "tools": {
    "deny": ["exec", "process"],
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave",
        "apiKey": "YOUR_BRAVE_API_KEY",
        "maxResults": 5
      }
    },
    "fs": {
      "workspaceOnly": true
    }
  },

  "bindings": [
    {
      "agentId": "personal",
      "match": { "channel": "feishu", "accountId": "personal" }
    },
    {
      "agentId": "hypercreator",
      "match": { "channel": "feishu", "accountId": "hypercreator" }
    },
    {
      "agentId": "raxonwood",
      "match": { "channel": "feishu", "accountId": "raxonwood" }
    }
  ],

  "messages": {
    "ackReactionScope": "group-mentions"
  },

  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },

  "session": {
    "dmScope": "per-account-channel-peer"
  },

  "channels": {
    "feishu": {
      "enabled": true,
      "streaming": true,
      "accounts": {
        "personal": {
          "appId": "YOUR_FEISHU_APP_ID",
          "appSecret": "YOUR_FEISHU_APP_SECRET",
          "botName": "Hyper Claw AI",
          "groupPolicy": "open"
        },
        "default": {
          "dmPolicy": "pairing",
          "groupPolicy": "open"
        },
        "hypercreator": {
          "appId": "YOUR_FEISHU_APP_ID",
          "appSecret": "YOUR_FEISHU_APP_SECRET",
          "botName": "Hyper Claw AI",
          "groupPolicy": "open"
        },
        "raxonwood": {
          "appId": "YOUR_FEISHU_APP_ID",
          "appSecret": "YOUR_FEISHU_APP_SECRET",
          "groupPolicy": "open"
        }
      },
      "defaultAccount": "personal"
    }
  },

  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "YOUR_GATEWAY_TOKEN"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "calendar.add",
        "contacts.add",
        "reminders.add"
      ]
    }
  },

  "plugins": {
    "allow": ["feishu", "hyper-claw-taskboard"],
    "entries": {
      "feishu": {
        "enabled": true
      },
      "hyper-claw-taskboard": {
        "enabled": true,
        "config": {}
      }
    }
  }
}
